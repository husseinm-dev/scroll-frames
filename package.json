{
  "name": "scroll-frames",
  "version": "0.1.1",
  "description": "Scroll-scrubbed image sequences (video → frames) for any element. Web component, React wrapper, and CLI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/element.ts",
    "./src/global.ts",
    "./dist/element.*",
    "./dist/scroll-frames.global.js",
    "./dist/chunk-*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./global": "./dist/scroll-frames.global.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/scroll-frames.global.js",
  "jsdelivr": "./dist/scroll-frames.global.js",
  "bin": {
    "scroll-frames": "./bin/scroll-frames.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "example": "node examples/serve.mjs",
    "prepack": "tsup",
    "release": "tsup && git add -A && git commit -m \"build\" --allow-empty"
  },
  "peerDependencies": {
    "react": ">=18",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "scroll",
    "scrollytelling",
    "image-sequence",
    "canvas",
    "video",
    "web-component",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/husseinm-dev/scroll-frames.git"
  }
}
